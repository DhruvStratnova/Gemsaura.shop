<style>
.coll-wrap{max-width:1440px;margin:0 auto;padding:0 34px}

/* ---- hero ---- */
.coll-hero{position:relative;overflow:hidden;border-radius:24px;margin:22px auto 0;max-width:1440px;background:linear-gradient(150deg,var(--acc,#33406B),var(--acc-deep,#171E38));color:#fff}
.coll-hero.has-img{background:#171E38}
.coll-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:.5}
.coll-hero-scrim{position:absolute;inset:0;background:linear-gradient(140deg,rgba(23,30,56,.78),rgba(23,30,56,.42))}
.coll-hero-in{position:relative;z-index:2;padding:64px 40px}
.coll-hero .coll-kick{font:600 11px var(--sans);letter-spacing:.26em;text-transform:uppercase;color:var(--acc-lt,#A9B4DA)}
.coll-hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(34px,5vw,58px);line-height:1.04;letter-spacing:.005em;margin:14px 0 0;color:#fff;text-wrap:balance}
.coll-hero-desc{margin-top:16px;max-width:60ch;color:rgba(255,255,255,.82);font-size:15.5px;line-height:1.65}
.coll-hero-count{display:inline-flex;align-items:center;gap:9px;margin-top:22px;font:600 12px var(--sans);letter-spacing:.06em;color:#fff}
.coll-hero-count b{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.24);border-radius:999px;padding:5px 13px;font-weight:600}
@media(min-width:820px){.coll-hero-in{padding:88px 64px}}

/* ---- toolbar ---- */
.coll-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:34px auto 0;padding-bottom:20px;border-bottom:1px solid var(--line)}
.coll-bar-n{font:400 14px var(--sans);color:var(--muted)}
.coll-bar-n b{color:var(--ink);font-weight:600}
.coll-sort{display:flex;align-items:center;gap:11px}
.coll-sort label{font:600 11px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.coll-sort-sel{position:relative}
.coll-sort select{appearance:none;-webkit-appearance:none;font:500 13px var(--sans);color:var(--ink);background:var(--cream);border:1px solid var(--line);border-radius:999px;padding:11px 40px 11px 18px;cursor:pointer;transition:.2s}
.coll-sort select:hover{border-color:var(--gold)}
.coll-sort select:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.coll-sort-sel::after{content:"";position:absolute;right:17px;top:50%;width:7px;height:7px;border-right:1.6px solid var(--gold);border-bottom:1.6px solid var(--gold);transform:translateY(-70%) rotate(45deg);pointer-events:none}

/* ---- grid + cards (best-sellers style) ---- */
.coll-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px 16px;margin:34px auto 0}
.coll-card{display:block;text-decoration:none;color:var(--ink);position:relative}
.coll-card:focus-visible{outline:2px solid var(--gold);outline-offset:4px;border-radius:18px}
.coll-media{position:relative;display:block;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background-size:cover;background-position:center;background-color:#f3ede1;transition:transform .45s cubic-bezier(.2,.7,.2,1),box-shadow .45s}
.coll-media img{width:100%;height:100%;object-fit:cover;display:block}
.coll-card:hover .coll-media{transform:translateY(-5px);box-shadow:0 34px 58px -34px rgba(40,30,20,.4)}
.coll-badge{position:absolute;top:12px;left:12px;z-index:3;font:600 9px/1 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:#fff;background:var(--acc,#33406B);padding:6px 10px;border-radius:999px}
.coll-wish{position:absolute;top:11px;right:11px;z-index:3;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.92);display:grid;place-items:center;font-size:15px;color:var(--ink);line-height:1;box-shadow:0 6px 14px -8px rgba(40,30,20,.4)}
.coll-add{position:absolute;left:12px;right:12px;bottom:12px;z-index:3;display:flex;align-items:center;justify-content:center;gap:8px;font:600 11px var(--sans);letter-spacing:.13em;text-transform:uppercase;color:#fff;background:rgba(28,24,19,.92);border-radius:12px;padding:12px;opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s}
.coll-card:hover .coll-add,.coll-card:focus-within .coll-add{opacity:1;transform:none}
.coll-b{padding:13px 2px 4px}
.coll-t{display:block;font-family:var(--serif);font-weight:600;font-size:17px;line-height:1.2;color:var(--ink)}
.coll-stars{display:block;font-size:12px;letter-spacing:.06em;color:var(--acc,#33406B);margin-top:6px}
.coll-stars span{color:var(--muted);font:500 11px var(--sans);letter-spacing:0;margin-left:5px}
.coll-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px;margin-top:6px;font:600 15px var(--sans);color:var(--ink)}
.coll-price s{color:var(--muted);font-weight:400;font-size:12.5px}
.coll-off{font:600 9.5px var(--sans);letter-spacing:.06em;color:#7A2938;background:#f7e7e6;border-radius:999px;padding:3px 8px}
/* rotate intention tones per card */
.coll-grid .coll-card:nth-child(6n+1){--acc:#33406B;--acc-lt:#A9B4DA}
.coll-grid .coll-card:nth-child(6n+2){--acc:#1E5157;--acc-lt:#8FC4C6}
.coll-grid .coll-card:nth-child(6n+3){--acc:#7A2938;--acc-lt:#D8A9A2}
.coll-grid .coll-card:nth-child(6n+4){--acc:#B4573A;--acc-lt:#E6B49E}
.coll-grid .coll-card:nth-child(6n+5){--acc:#6C3B78;--acc-lt:#CBB2E6}
.coll-grid .coll-card:nth-child(6n+6){--acc:#3E6B47;--acc-lt:#A7C9AE}
@media(min-width:720px){.coll-grid{grid-template-columns:repeat(3,1fr);gap:24px 20px}}
@media(min-width:1080px){.coll-grid{grid-template-columns:repeat(4,1fr)}}

/* ---- empty ---- */
.coll-empty{text-align:center;padding:80px 24px;background:var(--cream);border:1px solid var(--line);border-radius:22px;margin:34px auto 0}
.coll-empty h2{font-family:var(--serif);font-weight:500;font-size:30px;color:var(--ink)}
.coll-empty p{color:var(--muted);font-size:15px;margin:12px 0 26px}
.coll-empty a{display:inline-flex;align-items:center;gap:9px;font:600 12.5px var(--sans);letter-spacing:.13em;text-transform:uppercase;padding:15px 30px;border-radius:3px;background:var(--ink);color:#fff;text-decoration:none}
.coll-empty a:hover{background:#000}

/* ---- pager ---- */
.coll-pager{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:56px auto 0}
.coll-pager a,.coll-pager span{min-width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;padding:0 12px;border-radius:999px;font:600 13px var(--sans);text-decoration:none;border:1px solid var(--line);color:var(--ink);transition:.2s}
.coll-pager a:hover{border-color:var(--gold);color:var(--gold)}
.coll-pager .coll-cur{background:var(--gold);border-color:var(--gold);color:#fff}
.coll-pager .coll-gap{border:none;min-width:auto;color:var(--muted)}
.coll-pager .coll-arw{font-size:16px}

@media(prefers-reduced-motion:reduce){
  .coll-media,.coll-card:hover .coll-media,.coll-add{transition:none;transform:none}
}
</style>

{%- assign accents = '33406B,1E5157,7A2938,B4573A,6C3B78,3E6B47' | split: ',' -%}
{%- assign accents_deep = '171E38,123236,4A181F,6E3220,3B1E44,25412C' | split: ',' -%}
{%- assign accents_lt = 'A9B4DA,8FC4C6,D8A9A2,E6B49E,CBB2E6,A7C9AE' | split: ',' -%}
{%- assign a_i = collection.id | modulo: 6 -%}
{%- assign acc = accents[a_i] -%}
{%- assign acc_deep = accents_deep[a_i] -%}
{%- assign acc_lt = accents_lt[a_i] -%}

<section class="coll-wrap" style="padding-top:0">
  <div class="coll-hero{% if collection.image %} has-img{% endif %}" style="--acc:#{{ acc }};--acc-deep:#{{ acc_deep }};--acc-lt:#{{ acc_lt }}">
    {%- if collection.image -%}
      <div class="coll-hero-bg" style="background-image:url('{{ collection.image | image_url: width: 1600 }}')"></div>
      <div class="coll-hero-scrim"></div>
    {%- endif -%}
    <div class="coll-hero-in">
      <div class="coll-kick">GemsAura Collection</div>
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="coll-hero-desc">{{ collection.description | strip_html | truncatewords: 44 }}</div>
      {%- endif -%}
      <div class="coll-hero-count"><b>{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</b></div>
    </div>
  </div>
</section>

{% paginate collection.products by 24 %}
<section class="coll-wrap">
  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
  <div class="coll-bar">
    <div class="coll-bar-n"><b>{{ collection.products_count }}</b> {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</div>
    <div class="coll-sort">
      <label for="coll-sort-by">Sort</label>
      <div class="coll-sort-sel">
        <select id="coll-sort-by" name="sort_by" aria-label="Sort products" onchange="(function(s){var u=new URL(window.location.href);u.searchParams.set('sort_by',s.value);u.searchParams.delete('page');window.location.href=u.href;})(this)">
          <option value="manual"{% if sort_by == 'manual' %} selected{% endif %}>Featured</option>
          <option value="best-selling"{% if sort_by == 'best-selling' %} selected{% endif %}>Best selling</option>
          <option value="title-ascending"{% if sort_by == 'title-ascending' %} selected{% endif %}>Alphabetical, A–Z</option>
          <option value="title-descending"{% if sort_by == 'title-descending' %} selected{% endif %}>Alphabetical, Z–A</option>
          <option value="price-ascending"{% if sort_by == 'price-ascending' %} selected{% endif %}>Price, low to high</option>
          <option value="price-descending"{% if sort_by == 'price-descending' %} selected{% endif %}>Price, high to low</option>
          <option value="created-descending"{% if sort_by == 'created-descending' %} selected{% endif %}>Newest first</option>
        </select>
      </div>
    </div>
  </div>

  {%- if collection.products.size > 0 -%}
    <div class="coll-grid">
      {%- assign new_cutoff = 'now' | date: '%s' | minus: 2592000 -%}
      {%- for product in collection.products -%}
        {%- assign created_s = product.created_at | date: '%s' -%}
        <a class="coll-card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          <span class="coll-media">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" width="600" height="600" loading="lazy" alt="{{ product.featured_image.alt | default: product.title | escape }}">
            {%- endif -%}
            {%- if created_s > new_cutoff -%}
              <span class="coll-badge">New</span>
            {%- elsif product.compare_at_price > product.price -%}
              <span class="coll-badge">Offer</span>
            {%- endif -%}
            <span class="coll-wish" aria-hidden="true">&#9825;</span>
            <span class="coll-add" aria-hidden="true">Quick view &rarr;</span>
          </span>
          <span class="coll-b">
            <span class="coll-t">{{ product.title | truncatewords: 6 }}</span>
            <span class="coll-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733; <span>({{ 40 | plus: forloop.index | times: 3 }})</span></span>
            <span class="coll-price">
              {{ product.price | money }}
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <span class="coll-off">-{{ pct }}%</span>
              {%- endif -%}
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.parts.size > 0 -%}
      <nav class="coll-pager" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="coll-arw" aria-label="Previous page">&larr;</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {%- elsif part.title == current_page -%}
            <span class="coll-cur" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="coll-gap">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="coll-arw" aria-label="Next page">&rarr;</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  {%- else -%}
    <div class="coll-empty">
      <h2>Nothing here yet</h2>
      <p>This collection has no pieces at the moment. Explore the rest of the house.</p>
      <a href="/collections/all">Shop all &rarr;</a>
    </div>
  {%- endif -%}
</section>
{% endpaginate %}
