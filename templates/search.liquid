<style>
  .srch-wrap{max-width:1240px;padding-top:14px}
  .srch-head{text-align:center;max-width:640px;margin:0 auto 34px}
  .srch-head .kick{color:var(--gold)}
  .srch-head h1{font-family:var(--serif);font-weight:500;font-size:clamp(32px,4.8vw,52px);line-height:1.05;color:var(--ink);margin-top:10px;text-wrap:balance}
  .srch-form{display:flex;align-items:center;gap:8px;max-width:560px;margin:26px auto 0;background:var(--cream);border:1px solid var(--line);border-radius:999px;padding:6px 6px 6px 22px;transition:box-shadow .3s,border-color .3s}
  .srch-form:focus-within{border-color:var(--gold-lt);box-shadow:0 0 0 4px color-mix(in srgb,var(--gold) 10%,transparent)}
  .srch-form .ico{color:var(--gold);font-size:16px;flex:none}
  .srch-form input{flex:1;min-width:0;border:none;background:none;font:400 15.5px var(--sans);color:var(--ink);padding:12px 4px}
  .srch-form input:focus{outline:none}
  .srch-form input::placeholder{color:var(--muted)}
  .srch-form button{flex:none;background:var(--gold);color:#fff;border:none;cursor:pointer;font:600 12px var(--sans);letter-spacing:.13em;text-transform:uppercase;padding:13px 24px;border-radius:999px;transition:background .2s}
  .srch-form button:hover{background:var(--gold-deep)}
  .srch-count{text-align:center;color:var(--muted);font-size:13.5px;margin-top:20px}
  .srch-count b{color:var(--ink);font-weight:600}

  .srch-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:34px}
  @media(min-width:720px){.srch-grid{grid-template-columns:repeat(3,1fr);gap:20px}}
  @media(min-width:1040px){.srch-grid{grid-template-columns:repeat(4,1fr);gap:22px}}

  .srch-card{display:block;text-decoration:none;color:var(--ink)}
  .srch-im{position:relative;display:block;aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#f3ede1;border:1px solid var(--line);transition:transform .45s cubic-bezier(.2,.7,.2,1),box-shadow .45s}
  .srch-im img{width:100%;height:100%;object-fit:cover}
  .srch-card:hover .srch-im{transform:translateY(-3px);box-shadow:0 34px 58px -34px rgba(40,30,20,.4)}
  .srch-t{display:block;font-family:var(--serif);font-weight:600;font-size:18px;margin-top:12px;line-height:1.2}
  .srch-rt{display:block;font:500 12px var(--sans);color:var(--gold);margin-top:5px}
  .srch-rt span{color:var(--muted)}
  .srch-p{display:block;font:600 15px var(--sans);color:var(--ink);margin-top:5px}
  .srch-p s{color:var(--muted);font-weight:400;font-size:12px;margin-left:5px}

  .srch-doc{display:flex;flex-direction:column;justify-content:center;min-height:170px;background:var(--cream);border:1px solid var(--line);border-radius:16px;padding:22px;text-decoration:none;color:var(--ink);transition:transform .3s,box-shadow .3s}
  .srch-doc:hover{transform:translateY(-3px);box-shadow:0 34px 58px -34px rgba(40,30,20,.4)}
  .srch-doc .tag{font:600 9.5px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
  .srch-doc h3{font-family:var(--serif);font-weight:600;font-size:20px;line-height:1.2;margin:9px 0 6px;color:var(--ink)}
  .srch-doc p{font-size:13px;color:var(--muted);line-height:1.5}

  .srch-empty{text-align:center;max-width:520px;margin:34px auto 0;padding:30px 0}
  .srch-empty .ring{width:88px;height:88px;margin:0 auto 24px;border-radius:50%;display:grid;place-items:center;font-size:30px;color:var(--gold);border:2px solid color-mix(in srgb,var(--gold) 45%,var(--line));box-shadow:0 0 0 6px color-mix(in srgb,var(--gold) 8%,transparent)}
  .srch-empty h2{font-family:var(--serif);font-weight:500;font-size:28px;color:var(--ink);line-height:1.1}
  .srch-empty p{color:var(--muted);font-size:14.5px;margin:12px auto 0;max-width:36ch;line-height:1.6}

  .srch-nav{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:44px;flex-wrap:wrap}
  .srch-nav a,.srch-nav span{font:600 13px var(--sans);color:var(--muted);text-decoration:none;padding:9px 14px;border-radius:999px;border:1px solid transparent}
  .srch-nav a:hover{color:var(--gold);border-color:var(--line)}
  .srch-nav .current{background:var(--gold);color:#fff}

  @media(prefers-reduced-motion:reduce){
    .srch-card:hover .srch-im,.srch-doc:hover{transform:none}
  }
</style>

<section class="section"><div class="wrap srch-wrap">

  <div class="srch-head">
    <div class="kick">Search</div>
    <h1>Find your stone</h1>
    <form class="srch-form" action="{{ routes.search_url }}" method="get" role="search">
      <span class="ico" aria-hidden="true">&#9906;</span>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search crystals, intentions, collections&hellip;" aria-label="Search">
      <button type="submit">Search</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="srch-empty">
        <div class="ring">&#9906;</div>
        <h2>No matches found</h2>
        <p>We could not find anything for &ldquo;{{ search.terms | escape }}&rdquo;. Try a different word, an intention, or a stone name.</p>
      </div>
    {%- else -%}
      <p class="srch-count"><b>{{ search.results_count }}</b> {{ search.results_count | pluralize: 'result', 'results' }} for &ldquo;{{ search.terms | escape }}&rdquo;</p>

      {%- paginate search.results by 24 -%}
        <div class="srch-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <a class="srch-card" href="{{ item.url }}">
                <span class="srch-im">
                  {%- if item.featured_image -%}
                    <img src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" width="400" height="400" loading="lazy">
                  {%- endif -%}
                </span>
                <span class="srch-t">{{ item.title | truncatewords: 6 }}</span>
                {%- if item.price > 0 -%}
                  <span class="srch-p">{{ item.price | money }}{% if item.compare_at_price > item.price %} <s>{{ item.compare_at_price | money }}</s>{% endif %}</span>
                {%- endif -%}
              </a>
            {%- else -%}
              <a class="srch-doc" href="{{ item.url }}">
                <span class="tag">{{ item.object_type }}</span>
                <h3>{{ item.title | truncatewords: 8 }}</h3>
                {%- if item.content or item.excerpt -%}
                  <p>{{ item.excerpt | default: item.content | strip_html | truncatewords: 24 }}</p>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="srch-nav" role="navigation" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Prev</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- else -%}
    <div class="srch-empty">
      <div class="ring">&#9671;</div>
      <h2>What are you seeking?</h2>
      <p>Search by crystal, intention, or collection to find the piece meant for you.</p>
    </div>
  {%- endif -%}

</div></section>
