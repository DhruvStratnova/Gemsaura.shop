<style>
  .cart-wrap{max-width:1180px;padding-top:14px}
  .cart-head{margin-bottom:30px}
  .cart-head .kick{color:var(--gold)}
  .cart-head h1{font-family:var(--serif);font-weight:500;font-size:clamp(32px,4.6vw,50px);line-height:1.06;color:var(--ink);margin-top:10px;text-wrap:balance}
  .cart-count{color:var(--muted);font-size:14px;margin-top:8px}

  .cart-grid{display:grid;grid-template-columns:1fr;gap:26px}
  @media(min-width:900px){.cart-grid{grid-template-columns:1.55fr .95fr;gap:34px;align-items:start}}

  .cart-items{display:flex;flex-direction:column;gap:14px}
  .cart-line{display:grid;grid-template-columns:84px 1fr;gap:16px;background:var(--cream);border:1px solid var(--line);border-radius:18px;padding:16px;transition:box-shadow .3s,transform .3s}
  .cart-line:hover{box-shadow:0 34px 58px -34px rgba(40,30,20,.4);transform:translateY(-2px)}
  @media(min-width:560px){.cart-line{grid-template-columns:104px 1fr}}
  .cart-thumb{display:block;aspect-ratio:1/1;border-radius:12px;overflow:hidden;background:#f3ede1;border:1px solid var(--line)}
  .cart-thumb img{width:100%;height:100%;object-fit:cover}
  .cart-noimg{width:100%;height:100%;display:grid;place-items:center;color:var(--gold-lt);font-size:22px}

  .cart-body{display:flex;flex-direction:column;min-width:0}
  .cart-title{font-family:var(--serif);font-weight:600;font-size:20px;line-height:1.18;color:var(--ink);text-decoration:none}
  .cart-title:hover{color:var(--gold)}
  .cart-opts{font-size:12.5px;color:var(--muted);margin-top:4px}
  .cart-unit{font:600 12.5px var(--sans);color:var(--gold);margin-top:4px}
  .cart-line-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:auto;padding-top:14px;flex-wrap:wrap}

  .cart-qty{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:999px;background:#fff;overflow:hidden}
  .cart-qty button{width:36px;height:38px;border:none;background:none;cursor:pointer;font-size:17px;color:var(--ink);line-height:1;display:grid;place-items:center;transition:background .2s,color .2s}
  .cart-qty button:hover{background:var(--gold);color:#fff}
  .cart-qty input{width:42px;height:38px;border:none;text-align:center;font:600 14px var(--sans);color:var(--ink);background:none;-moz-appearance:textfield}
  .cart-qty input::-webkit-outer-spin-button,.cart-qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .cart-qty input:focus{outline:none}

  .cart-line-right{display:flex;align-items:center;gap:16px;margin-left:auto}
  .cart-linetotal{font:600 16px var(--sans);color:var(--ink);white-space:nowrap}
  .cart-remove{font:500 11.5px var(--sans);letter-spacing:.04em;color:var(--muted);text-decoration:none;border-bottom:1px solid transparent;transition:.2s}
  .cart-remove:hover{color:var(--gold);border-color:var(--gold)}

  .cart-summary{position:sticky;top:96px;background:var(--cream);border:1px solid var(--line);border-radius:18px;padding:26px 24px}
  .cart-summary h2{font-family:var(--serif);font-weight:600;font-size:24px;color:var(--ink);margin-bottom:18px}
  .cart-note label{display:block;font:600 10.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}
  .cart-note textarea{width:100%;min-height:76px;resize:vertical;border:1px solid var(--line);border-radius:12px;background:#fff;padding:12px 13px;font:400 14px var(--sans);color:var(--ink);line-height:1.5}
  .cart-note textarea:focus{outline:none;border-color:var(--gold-lt);box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 12%,transparent)}
  .cart-subrow{display:flex;align-items:baseline;justify-content:space-between;margin:22px 0 4px;padding-top:20px;border-top:1px solid var(--line)}
  .cart-subrow .l{font:600 12px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .cart-subrow .v{font-family:var(--serif);font-weight:600;font-size:28px;color:var(--ink)}
  .cart-tax{font-size:12px;color:var(--muted);margin-bottom:20px}
  .cart-checkout{width:100%;justify-content:center;background:var(--gold);color:#fff;border:1px solid var(--gold);font:600 13px var(--sans);letter-spacing:.14em;text-transform:uppercase;padding:17px;border-radius:3px;cursor:pointer;transition:.2s}
  .cart-checkout:hover{background:var(--gold-deep);border-color:var(--gold-deep)}
  .cart-update{width:100%;justify-content:center;background:transparent;color:var(--ink);border:1px solid var(--ink);font:600 12px var(--sans);letter-spacing:.13em;text-transform:uppercase;padding:14px;border-radius:3px;cursor:pointer;margin-top:11px;transition:.2s}
  .cart-update:hover{background:var(--ink);color:#fff}

  .cart-empty{text-align:center;padding:40px 0 12px;max-width:520px;margin:0 auto}
  .cart-empty .ring{width:96px;height:96px;margin:0 auto 26px;border-radius:50%;display:grid;place-items:center;font-size:34px;color:var(--gold);border:2px solid color-mix(in srgb,var(--gold) 45%,var(--line));box-shadow:0 0 0 6px color-mix(in srgb,var(--gold) 8%,transparent)}
  .cart-empty h1{font-family:var(--serif);font-weight:500;font-size:clamp(30px,4.4vw,44px);color:var(--ink);line-height:1.08}
  .cart-empty p{color:var(--muted);font-size:15px;margin:14px auto 28px;max-width:38ch;line-height:1.6}
  .cart-empty .btn{background:var(--gold);color:#fff;border:1px solid var(--gold)}
  .cart-empty .btn:hover{background:var(--gold-deep);border-color:var(--gold-deep)}

  .cart-xsell{margin-top:64px;border-top:1px solid var(--line);padding-top:44px}
  .cart-xsell .kick{color:var(--gold)}
  .cart-xsell h2{font-family:var(--serif);font-weight:500;font-size:clamp(24px,3vw,32px);color:var(--ink);margin-top:8px}
  .cart-xgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:26px}
  @media(min-width:720px){.cart-xgrid{grid-template-columns:repeat(4,1fr);gap:20px}}
  .cart-xcard{display:block;text-decoration:none;color:var(--ink)}
  .cart-xim{position:relative;display:block;aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#f3ede1;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
  .cart-xim img{width:100%;height:100%;object-fit:cover}
  .cart-xcard:hover .cart-xim{transform:scale(1.03)}
  .cart-xt{display:block;font-family:var(--serif);font-weight:600;font-size:17px;margin-top:12px;line-height:1.2}
  .cart-xp{display:block;font:600 15px var(--sans);color:var(--ink);margin-top:5px}
  .cart-xp s{color:var(--muted);font-weight:400;font-size:12px;margin-left:5px}

  @media(prefers-reduced-motion:reduce){
    .cart-line:hover,.cart-xcard:hover .cart-xim{transform:none}
  }
</style>

<section class="section"><div class="wrap cart-wrap">

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <div class="ring">&#9671;</div>
      <div class="kick" style="color:var(--gold)">Your bag</div>
      <h1>Nothing gathered yet</h1>
      <p>Your bag is waiting. Explore our hand-set crystals and let a piece choose you.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    </div>

  {%- else -%}
    <div class="cart-head">
      <div class="kick">Your bag</div>
      <h1>Review your pieces</h1>
      <div class="cart-count">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }} gathered</div>
    </div>

    {%- form 'cart', cart, class: 'cart-form' -%}
      <div class="cart-grid">
        <div class="cart-items">
          {%- for item in cart.items -%}
            <div class="cart-line">
              <a class="cart-thumb" href="{{ item.url }}">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="104" height="104" loading="lazy">
                {%- else -%}
                  <span class="cart-noimg">&#9671;</span>
                {%- endif -%}
              </a>
              <div class="cart-body">
                <a class="cart-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <div class="cart-opts">
                    {%- for opt in item.options_with_values -%}
                      {{ opt.name }}: {{ opt.value }}{%- unless forloop.last %} &middot; {% endunless -%}
                    {%- endfor -%}
                  </div>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <div class="cart-opts">{{ item.selling_plan_allocation.selling_plan.name }}</div>
                {%- endif -%}
                <div class="cart-unit">{{ item.final_price | money }} each</div>

                <div class="cart-line-foot">
                  <div class="cart-qty">
                    <button type="button" class="cart-dec" aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}">
                    <button type="button" class="cart-inc" aria-label="Increase quantity">&plus;</button>
                  </div>
                  <div class="cart-line-right">
                    <span class="cart-linetotal">{{ item.final_line_price | money }}</span>
                    <a class="cart-remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="cart-summary">
          <h2>Order summary</h2>
          <div class="cart-note">
            <label for="cart-note">Add a note</label>
            <textarea id="cart-note" name="note" placeholder="Gift message or special requests&hellip;">{{ cart.note }}</textarea>
          </div>
          <div class="cart-subrow">
            <span class="l">Subtotal</span>
            <span class="v">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-tax">Taxes &amp; shipping calculated at checkout.</p>
          <button type="submit" name="checkout" class="cart-checkout">Checkout</button>
          <button type="submit" name="update" class="cart-update">Update cart</button>
        </aside>
      </div>
    {%- endform -%}

    {%- assign xsell = collections.all.products -%}
    {%- if xsell.size > 0 -%}
      <div class="cart-xsell">
        <div class="kick">Curated for you</div>
        <h2>You may also like</h2>
        <div class="cart-xgrid">
          {%- for product in xsell limit: 4 -%}
            <a class="cart-xcard" href="{{ product.url }}">
              <span class="cart-xim">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="300" height="300" loading="lazy">
                {%- endif -%}
              </span>
              <span class="cart-xt">{{ product.title | truncatewords: 5 }}</span>
              <span class="cart-xp">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

</div></section>

<script>
  (function(){
    var form=document.querySelector('.cart-form');
    if(!form)return;
    form.addEventListener('click',function(e){
      var btn=e.target.closest('.cart-inc,.cart-dec');
      if(!btn)return;
      var input=btn.parentNode.querySelector('input[type=number]');
      if(!input)return;
      var v=parseInt(input.value,10);if(isNaN(v))v=0;
      if(btn.classList.contains('cart-inc'))v++;else v=Math.max(0,v-1);
      input.value=v;
      input.dispatchEvent(new Event('change',{bubbles:true}));
    });
    form.addEventListener('change',function(e){
      if(!e.target.matches('input[name^="updates["]'))return;
      var upd=form.querySelector('button[name=update]');
      if(upd){if(form.requestSubmit)form.requestSubmit(upd);else{upd.click();}}
    });
  })();
</script>
