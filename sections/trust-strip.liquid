<div class="strip"><div class="wrap">
  {% for b in section.blocks %}<div class="it"><i>✦</i> {{ b.settings.text }}</div>{% endfor %}
</div></div>
{% schema %}
{"name":"Trust strip","max_blocks":5,
 "blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Lab-certified"}]}],
 "presets":[{"name":"Trust strip","blocks":[
   {"type":"item","settings":{"text":"40,000+ wrists across the Gulf"}},
   {"type":"item","settings":{"text":"Independently lab-certified"}},
   {"type":"item","settings":{"text":"Real Cambodian oud"}},
   {"type":"item","settings":{"text":"★ 4.8 average rating"}}]}]}
{% endschema %}
