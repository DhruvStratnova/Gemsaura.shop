<section class="section"><div class="wrap">
  <div class="prow"><div><div class="kick">The Collection</div><h2 class="t" style="margin-top:8px">Worn this <span class="i">season</span></h2></div><a class="btn ghost" href="{{ section.settings.view_all_url }}">View all</a></div>
  <div class="cards">
    {% if section.settings.collection != blank %}
      {% assign col = collections[section.settings.collection] %}
      {% for product in col.products limit: 4 %}
        <a class="pc" href="{{ product.url }}">
          <div class="im" style="background-image:url('{{ product.featured_image | image_url: width:600 }}');background-size:cover;background-position:center"><span class="oud">Crystal + Oud</span></div>
          <div class="pb"><div class="rt">★★★★★ 4.8</div><h4>{{ product.title }}</h4><div class="sub2">{{ product.type }}</div>
          <div class="pr">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div>
        </a>
      {% endfor %}
    {% else %}
      {% for b in section.blocks %}
        <a class="pc" href="{{ b.settings.url }}">
          <div class="im" style="background:{{ b.settings.swatch }}"><span class="oud">Crystal + Oud</span></div>
          <div class="pb"><div class="rt">★★★★★ {{ b.settings.rating }}</div><h4>{{ b.settings.title }}</h4><div class="sub2">{{ b.settings.sub }}</div>
          <div class="pr">{{ b.settings.price }} <s>{{ b.settings.compare }}</s></div></div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div></section>
{% schema %}
{"name":"Product rail","max_blocks":8,
 "settings":[
   {"type":"text","id":"heading","label":"Heading","default":"Worn this season"},
   {"type":"collection","id":"collection","label":"Collection (optional — overrides blocks)"},
   {"type":"url","id":"view_all_url","label":"View all link"}],
 "blocks":[{"type":"card","name":"Card","settings":[
   {"type":"text","id":"title","label":"Title","default":"Pyrite Prosperity"},
   {"type":"text","id":"sub","label":"Subtitle","default":"Wealth · steel clasp · oud-infused"},
   {"type":"text","id":"price","label":"Price","default":"AED 349"},
   {"type":"text","id":"compare","label":"Compare price","default":"AED 899"},
   {"type":"text","id":"rating","label":"Rating","default":"4.8"},
   {"type":"text","id":"swatch","label":"Placeholder swatch (CSS)","default":"radial-gradient(circle at 42% 34%,#efd39a,#B98E3E 46%,#7a5a28 82%)"},
   {"type":"url","id":"url","label":"Link"}]}],
 "presets":[{"name":"Product rail","blocks":[
   {"type":"card","settings":{"title":"Pyrite Prosperity","sub":"Wealth · steel clasp · oud-infused","swatch":"radial-gradient(circle at 42% 34%,#efd39a,#B98E3E 46%,#7a5a28 82%)"}},
   {"type":"card","settings":{"title":"Amethyst Stillness","sub":"Calm · steel clasp · oud-infused","rating":"4.9","swatch":"radial-gradient(circle at 42% 34%,#cbb6e2,#6A4E76 50%,#33223d 84%)"}},
   {"type":"card","settings":{"title":"Aventurine Fortune","sub":"Luck · steel clasp · oud-infused","swatch":"radial-gradient(circle at 42% 34%,#a6dcb5,#3f6b4e 50%,#1e3327 84%)"}},
   {"type":"card","settings":{"title":"Tourmaline Shield","sub":"Protection · steel clasp · oud-infused","rating":"4.9","swatch":"radial-gradient(circle at 42% 34%,#4a463e,#141210 62%)"}}]}]}
{% endschema %}
