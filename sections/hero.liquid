    <div class="hero2-cta">
      <a class="btn dark" href="/collections/crystal-bracelets">Shop the collection</a>
      <a class="btn light" href="#intent">Shop by intention</a>
    </div>
    <div class="hero2-ar">طاقة تُلبس… وتُشتمّ</div>
  </div>
  <div class="hero2-mark">GEMSAURA</div>
