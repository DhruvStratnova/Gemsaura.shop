<section class="hero" data-hero>
  <div class="slides">
    {% for b in section.blocks %}
      <div class="slide">
        <a href="{{ b.settings.url | default: '/collections/all' }}">
          <picture>
            {% if b.settings.mobile != blank %}<source media="(max-width:700px)" srcset="{{ b.settings.mobile | asset_url }}">{% endif %}
            <img src="{{ b.settings.desktop | asset_url }}" alt="{{ b.settings.alt | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          </picture>
        </a>
        {% if b.settings.heading != blank %}
        <div class="cap">
          {% if b.settings.eyebrow != blank %}<div class="eyebrow">{{ b.settings.eyebrow }}</div>{% endif %}
          <h1>{{ b.settings.heading }}</h1>
          {% if b.settings.sub != blank %}<p>{{ b.settings.sub }}</p>{% endif %}
          {% if b.settings.btn != blank %}<div><a class="btn btn--light" href="{{ b.settings.url | default: '/collections/all' }}">{{ b.settings.btn }}</a></div>{% endif %}
        </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <button class="arw prev" aria-label="Previous">&lsaquo;</button>
    <button class="arw next" aria-label="Next">&rsaquo;</button>
    <div class="dots">{% for b in section.blocks %}<button class="{% if forloop.first %}on{% endif %}" aria-label="Slide {{ forloop.index }}"></button>{% endfor %}</div>
  {% endif %}
</section>
{% schema %}
{"name":"Hero","max_blocks":6,"blocks":[{"type":"slide","name":"Slide","settings":[
  {"type":"text","id":"desktop","label":"Desktop image (asset)","default":"aa-hero-zodiac.jpg"},
  {"type":"text","id":"mobile","label":"Mobile image (asset)"},
  {"type":"text","id":"alt","label":"Alt text"},
  {"type":"text","id":"eyebrow","label":"Eyebrow"},
  {"type":"text","id":"heading","label":"Heading"},
  {"type":"text","id":"sub","label":"Subtext"},
  {"type":"text","id":"btn","label":"Button label"},
  {"type":"url","id":"url","label":"Link"}]}],
 "presets":[{"name":"Hero","blocks":[
  {"type":"slide","settings":{"desktop":"aa-hero-zodiac.jpg","mobile":"aa-hero-zodiac-mobile.webp","alt":"Zodiac bracelets","eyebrow":"The house of intentions","heading":"Energy you can wear.","sub":"Certified crystals and silver, energised by hand and delivered across the UAE.","btn":"Shop the edit","url":"/collections/all"}},
  {"type":"slide","settings":{"desktop":"aa-hero-bracelets.jpg","mobile":"aa-hero-bracelets-mobile.webp","alt":"Crystal bracelets","eyebrow":"New in","heading":"Crystal bracelets, for every intention.","sub":"Hand-knotted, lab-certified, worn with meaning.","btn":"Shop bracelets","url":"/collections/crystal-bracelets"}}]}]}
{% endschema %}
