<section class="hbanner">
  <div class="hslides" id="hslides">
    {% for b in section.blocks %}
      <div class="hslide{% if forloop.first %} on{% endif %}">
        <a href="{{ b.settings.url }}">
          <picture>
            {% if b.settings.mobile != blank %}<source media="(max-width:700px)" srcset="{{ b.settings.mobile | asset_url }}">{% endif %}
            <img src="{{ b.settings.desktop | asset_url }}" alt="{{ b.settings.alt | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          </picture>
        </a>
      </div>
    {% endfor %}
    {% if section.blocks.size > 1 %}
      <button class="harrow prev" id="hprev" aria-label="Previous">&lsaquo;</button>
      <button class="harrow next" id="hnext" aria-label="Next">&rsaquo;</button>
      <div class="hdots" id="hdots"></div>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Hero banner","max_blocks":6,
 "blocks":[{"type":"slide","name":"Slide","settings":[
   {"type":"text","id":"desktop","label":"Desktop image (assets)","default":"aa-hero-zodiac.jpg"},
   {"type":"text","id":"mobile","label":"Mobile image (assets)"},
   {"type":"text","id":"alt","label":"Alt"},{"type":"url","id":"url","label":"Link"}]}],
 "presets":[{"name":"Hero banner","blocks":[
   {"type":"slide","settings":{"desktop":"aa-hero-zodiac.jpg","mobile":"aa-hero-zodiac-mobile.webp","alt":"Zodiac"}},
   {"type":"slide","settings":{"desktop":"aa-hero-bracelets.jpg","mobile":"aa-hero-bracelets-mobile.webp","alt":"Crystal bracelets"}}]}]}
{% endschema %}
