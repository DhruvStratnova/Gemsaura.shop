<section class="section circles"><div class="wrap">
  <div class="circlerow">
    {%- assign rows = "crystal-bracelets|Bracelets;;rashi-bracelets|Zodiac;;silver-bracelets|Silver;;anklets|Anklets;;pendants|Pendants;;crystals|Crystals;;rudraksha|Rudraksha;;pyramids|Home" | split:";;" -%}
    {%- for row in rows -%}{%- assign c = row | split:"|" -%}{%- assign col = collections[c[0]] -%}
      <a class="circle" href="{{ col.url }}"><span class="circle-im" style="background-image:url('{{ col.image | default: col.products.first.featured_image | image_url: width: 300 }}')"></span><span class="circle-t">{{ c[1] }}</span></a>
    {%- endfor -%}
    <a class="circle" href="/collections"><span class="circle-im circle-all">&rarr;</span><span class="circle-t">View all</span></a>
  </div>
</div></section>
{% schema %}
{"name":"Category circles","settings":[],"presets":[{"name":"Category circles"}]}
{% endschema %}
