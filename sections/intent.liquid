<section class="section intent" id="intent"><div class="wrap">
  <div class="sechead"><div class="kick">Shop by intention</div><h2 class="t">What do you want to <span class="i">invite in?</span></h2></div>
  <div class="intentgrid">
    {%- assign rows = "Wealth & Fortune|Money · growth|aa-banner-purpose-wealth-prosperity.jpg|/collections/money;;Peace & Calm|Sleep · stillness|aa-banner-purpose-peace-calm.jpg|/collections/purpose-peace-calm;;Protection|Shielding · calm|aa-banner-purpose-protection.jpg|/search?q=protection;;Love & Harmony|Connection|aa-banner-purpose-love-relationships.jpg|/search?q=rose%20quartz" | split:";;" -%}
    {%- for row in rows -%}{%- assign c = row | split:"|" -%}
      <a class="intentcard" href="{{ c[3] }}" style="background-image:linear-gradient(180deg,rgba(28,22,14,.02) 30%,rgba(28,22,14,.72)),url('{{ c[2] | asset_url }}')">
        <span class="intentcard-b"><span class="intentcard-t">{{ c[0] }}</span><span class="intentcard-s">{{ c[1] }}</span><span class="intentcard-shop">Shop <i>&rarr;</i></span></span>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{"name":"Intent","settings":[],"presets":[{"name":"Intent"}]}
{% endschema %}
