<section class="section intent"><div class="wrap">
  <div class="sechead"><div class="kick">Shop by intention</div><h2 class="t">{{ section.settings.heading }}</h2></div>
  <div class="intentgrid">
    {%- assign rows = "Wealth & Fortune|aa-banner-purpose-wealth-prosperity.jpg|/collections/money;;Peace & Calm|aa-banner-purpose-peace-calm.jpg|/collections/purpose-peace-calm;;Protection|aa-banner-purpose-protection.jpg|/search?q=protection;;Love & Harmony|aa-banner-purpose-love-relationships.jpg|/search?q=rose%20quartz" | split:";;" -%}
    {%- for row in rows -%}{%- assign c = row | split:"|" -%}
      <a class="intentcard" href="{{ c[2] }}" style="background-image:linear-gradient(180deg,rgba(28,22,14,.02) 35%,rgba(28,22,14,.66)),url('{{ c[1] | asset_url }}')">
        <span class="intentcard-t">{{ c[0] }}</span>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{"name":"Intent","settings":[{"type":"text","id":"heading","label":"Heading","default":"What do you want to invite in?"}],"presets":[{"name":"Intent"}]}
{% endschema %}
