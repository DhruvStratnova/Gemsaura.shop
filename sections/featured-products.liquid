{%- assign col = collections[section.settings.collection] | default: collections['crystal-bracelets'] -%}
<section class="sec"><div class="wrap" data-rail>
  <div class="shead" style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;position:relative">
    <div><div class="eyebrow">{{ section.settings.eyebrow | default: 'Loved by 40,000+ wrists' }}</div><h2 class="h2">{{ section.settings.heading | default: 'Bestsellers' }}</h2></div>
    <a class="link-u" href="{{ col.url | default: '/collections/all' }}">View all</a>
    <div class="rail-arw"><button data-prev aria-label="Previous">&lsaquo;</button><button data-next aria-label="Next">&rsaquo;</button></div>
  </div>
  <div class="track">
    {%- for p in col.products limit: 12 -%}{%- assign v = p.selected_or_first_available_variant -%}
      <a class="pcard" href="{{ p.url }}">
        <span class="im">
          {% if p.compare_at_price > p.price %}<span class="tag">Sale</span>{% elsif forloop.index <= 2 %}<span class="tag">Bestseller</span>{% endif %}
          <span class="heart">&#9825;</span>
          <img src="{{ p.featured_image | image_url: width: 520 }}" alt="{{ p.title | escape }}" loading="lazy">
          <span class="add" data-add="{{ v.id }}">Add to cart</span>
        </span>
        <span class="nm">{{ p.title }}</span>
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="pr">{{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}</span>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{"name":"Product rail","settings":[
  {"type":"collection","id":"collection","label":"Collection"},
  {"type":"text","id":"eyebrow","label":"Eyebrow"},
  {"type":"text","id":"heading","label":"Heading"}],
 "presets":[{"name":"Product rail"}]}
{% endschema %}
