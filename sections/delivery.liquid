<section class="section"><div class="wrap">
  <div style="text-align:center"><div class="kick">The Promise</div><h2 class="t" style="margin-top:8px">{{ section.settings.heading }}</h2></div>
  <div class="deliv">{% for b in section.blocks %}
    <div class="dp"><div class="n">{{ b.settings.n }}</div><div class="l">{{ b.settings.l }}</div></div>
  {% endfor %}</div>
</div></section>
{% schema %}
{"name":"Delivery","max_blocks":4,
 "settings":[{"type":"text","id":"heading","label":"Heading","default":"Premium, all the way to your door."}],
 "blocks":[{"type":"promise","name":"Promise","settings":[
   {"type":"text","id":"n","label":"Big text","default":"1–3 days"},{"type":"text","id":"l","label":"Label","default":"UAE delivery, tracked"}]}],
 "presets":[{"name":"Delivery","blocks":[
   {"type":"promise","settings":{"n":"1–3 days","l":"UAE delivery, tracked"}},
   {"type":"promise","settings":{"n":"Live","l":"WhatsApp updates, every step"}},
   {"type":"promise","settings":{"n":"Free","l":"Shipping & easy returns"}},
   {"type":"promise","settings":{"n":"Tabby","l":"Card · Apple Pay · COD"}}]}]}
{% endschema %}
