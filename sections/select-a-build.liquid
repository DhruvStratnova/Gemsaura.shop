<section class="section cou"><div class="wrap">
  <div style="text-align:center;max-width:660px;margin:0 auto">
    <div class="kick">The Signature · Select a Build</div>
    <h2 class="t" style="margin-top:10px">{{ section.settings.heading }}</h2>
    <p class="sub" style="margin-top:12px">{{ section.settings.body }}</p>
  </div>
  <div class="tiers">
    {% for b in section.blocks %}
      <div class="tier {% if b.settings.featured %}mid{% endif %}">
        {% if b.settings.badge != blank %}<div class="badge">{{ b.settings.badge }}</div>{% endif %}
        <div class="nm">{{ b.settings.name }}</div>
        <div class="de">{{ b.settings.desc }}</div>
        <ul>{% assign feats = b.settings.features | newline_to_br | split:'<br />' %}{% for f in feats %}{% if f != blank %}<li><i>✦</i> {{ f | strip }}</li>{% endif %}{% endfor %}</ul>
        <div class="pr">{{ b.settings.price }}</div>
      </div>
    {% endfor %}
  </div>
</div></section>
{% schema %}
{"name":"Select a build","max_blocks":3,
 "settings":[
   {"type":"text","id":"heading","label":"Heading","default":"Same stone. Three levels of ritual."},
   {"type":"textarea","id":"body","label":"Body","default":"Every GemsAura stone comes in three builds. The crystal is the remedy. The oud is the luxury. You choose how deep the ritual goes."}],
 "blocks":[{"type":"tier","name":"Tier","settings":[
   {"type":"text","id":"name","label":"Name","default":"Crystal"},
   {"type":"textarea","id":"desc","label":"Description"},
   {"type":"textarea","id":"features","label":"Features (one per line)"},
   {"type":"text","id":"price","label":"Price","default":"from AED 249"},
   {"type":"text","id":"badge","label":"Badge (optional)"},
   {"type":"checkbox","id":"featured","label":"Featured","default":false}]}],
 "presets":[{"name":"Select a build","blocks":[
   {"type":"tier","settings":{"name":"Crystal","desc":"The certified stone, energised and ready to wear.","features":"Lab-certified natural stone\nSteel-core clasp\nEnergised before dispatch","price":"from AED 249"}},
   {"type":"tier","settings":{"name":"Crystal + Oud","desc":"The stone, infused with real Cambodian oud. Energy you wear and breathe.","features":"Everything in Crystal\nHand-infused pure oud\nSignature scent, lasts weeks","price":"from AED 349","badge":"Most loved","featured":true}},
   {"type":"tier","settings":{"name":"Oud Reserve","desc":"Aged oud, gold-finished clasp, presented in the keepsake box.","features":"Everything in Crystal + Oud\nAged reserve oud + gold clasp\nKeepsake gift box","price":"from AED 549"}}]}]}
{% endschema %}
