{%- assign col = collections[section.settings.collection] | default: collections['our-products'] -%}
<section class="sec"><div class="wrap">
  <div class="shead center"><div class="eyebrow">{{ section.settings.eyebrow | default: 'Fresh in' }}</div><h2 class="h2">{{ section.settings.heading | default: 'New arrivals' }}</h2></div>
  <div class="grid4">
    {%- for p in col.products limit: 8 -%}{%- assign v = p.selected_or_first_available_variant -%}
      <a class="pcard rv" href="{{ p.url }}">
        <span class="im">
          {% if p.compare_at_price > p.price %}<span class="tag">Sale</span>{% elsif forloop.index <= 2 %}<span class="tag">New</span>{% endif %}
          <span class="heart">&#9825;</span>
          <img src="{{ p.featured_image | image_url: width: 520 }}" alt="{{ p.title | escape }}" loading="lazy">
          <span class="add" data-add="{{ v.id }}">Add to cart</span>
        </span>
        <span class="nm">{{ p.title }}</span>
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="pr">{{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}</span>
      </a>
    {%- endfor -%}
  </div>
  <div class="center" style="margin-top:36px"><a class="btn" href="{{ col.url | default: '/collections/all' }}">Shop all</a></div>
</div></section>
{% schema %}
{"name":"Product grid","settings":[
  {"type":"collection","id":"collection","label":"Collection"},
  {"type":"text","id":"eyebrow","label":"Eyebrow"},
  {"type":"text","id":"heading","label":"Heading"}],
 "presets":[{"name":"Product grid"}]}
{% endschema %}
