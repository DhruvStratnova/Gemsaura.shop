<section class="section"><div class="wrap">
  <div class="kick">The Unboxing</div>
  <div class="pack">
    <div class="art"><div class="box"><div class="lg">GEMSAURA</div></div></div>
    <div class="txt">
      <h2 class="t">{{ section.settings.heading }}</h2>
      <p class="sub" style="margin-top:14px;max-width:42ch">{{ section.settings.body }}</p>
      <div style="margin-top:26px"><a class="btn ghost" href="{{ section.settings.cta_url }}">{{ section.settings.cta }}</a></div>
    </div>
  </div>
</div></section>
{% schema %}
{"name":"Packaging","settings":[
  {"type":"text","id":"heading","label":"Heading","default":"A gift, before it's even given."},
  {"type":"textarea","id":"body","label":"Body","default":"Magnetic keepsake box. Oud-scented tissue. A certificate of authenticity and a card with your stone's intent and how to wear it. The kind of package people photograph before they open it."},
  {"type":"text","id":"cta","label":"Button","default":"See the packaging"},
  {"type":"url","id":"cta_url","label":"Button link"}
],"presets":[{"name":"Packaging"}]}
{% endschema %}
