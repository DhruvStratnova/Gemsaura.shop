    <div class="diffhead"><span></span><span class="diff-us">GemsAura</span><span class="diff-them">Ordinary crystal brands</span></div>
    {%- assign rows = "Real Cambodian oud, hand-infused|Yes|None;;Independently lab-certified stones|Every piece|Often uncertified;;Energised by hand before dispatch|Always|Mass-packed;;Keepsake gift packaging|Included|Plastic pouch;;Matched to your intention|Guided|Generic shelf;;UAE delivery, tracked|1–3 days|Weeks / imported" | split:";;" -%}
