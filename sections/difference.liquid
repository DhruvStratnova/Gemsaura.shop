      <div class="diffrow"><span class="diff-l">{{ c[0] }}</span><span class="diff-us"><i class="yes">&#10003;</i> {{ c[1] }}</span><span class="diff-them"><i class="no">&#10005;</i> {{ c[2] }}</span></div>
    {%- endfor -%}
  </div>
</div></section>
