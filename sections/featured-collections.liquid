<section class="sec"><div class="wrap">
  <div class="shead center"><div class="eyebrow">Shop by intention</div><h2 class="h2">What do you want to <em>carry?</em></h2></div>
  <div class="concerns">
    {%- assign rows = "aa-banner-purpose-wealth-prosperity.jpg|Wealth|Pyrite &amp; Citrine|/collections/all;;aa-banner-purpose-love-relationships.jpg|Love|Rose Quartz|/collections/all;;aa-banner-purpose-focus-clarity.jpg|Focus|Tiger Eye|/collections/all;;aa-banner-purpose-protection.jpg|Protection|Black Tourmaline|/collections/all;;aa-banner-purpose-health-wellness.jpg|Health|Amethyst|/collections/all;;aa-banner-purpose-peace-calm.jpg|Peace|Selenite|/collections/all" | split:";;" -%}
    {%- for r in rows -%}{%- assign c = r | split:"|" -%}
      <a class="concern rv" href="{{ c[3] }}"><img src="{{ c[0] | asset_url }}" alt="{{ c[1] }}" loading="lazy"><span class="cb"><b>{{ c[1] }}</b><span>{{ c[2] }}</span></span></a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}{"name":"Concern grid","settings":[],"presets":[{"name":"Concern grid"}]}{% endschema %}
