<section class="section story"><div class="wrap">
  <div class="story-grid">
    <div class="story-im" style="background-image:url('{{ 'aa-coll-crystal-bracelets.jpg' | asset_url }}')"></div>
    <div class="story-b">
      <div class="kick">The house of crystal &amp; oud</div>
      <h2 class="t">Energy you can wear.<br>And <span class="i">breathe.</span></h2>
      <p class="story-p">{{ section.settings.body }}</p>
      <a class="btn dark" href="{{ section.settings.cta_url }}">{{ section.settings.cta }}</a>
    </div>
  </div>
</div></section>
{% schema %}
{"name":"Story","settings":[
  {"type":"textarea","id":"body","label":"Body","default":"Certified natural crystals, infused with real Cambodian oud. Every piece is lab-verified, energised by hand, and sealed in a keepsake box — a remedy that happens to be the most beautiful thing on your wrist."},
  {"type":"text","id":"cta","label":"Button","default":"Our story"},
  {"type":"url","id":"cta_url","label":"Button link"}
],"presets":[{"name":"Story"}]}
{% endschema %}
