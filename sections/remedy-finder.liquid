<section class="section rf" id="remedy">
  <div class="wrap">
    <div class="rf-head">
      <div class="kick">The Remedy Finder</div>
      <h2 class="t">What do you want to invite in?</h2>
      <p class="sub">Choose an intention. We name the stone that carries it — then pair it with real oud.</p>
    </div>

    {%- assign rows = "wealth|Wealth & Fortune|Money · growth · abundance|Pyrite|Pyrite grounds scattered money energy and draws cash flow back to you.|aa-banner-stone-pyrite.jpg|/search?q=pyrite|/collections/money;;calm|Peace & Calm|Sleep · stress · stillness|Amethyst|Amethyst quiets an overthinking mind and returns you to your centre.|aa-banner-stone-amethyst.jpg|/collections/amethyst|/collections/purpose-peace-calm;;protection|Protection|Evil eye · negativity · shielding|Black Tourmaline|Black Tourmaline forms a shield against negativity, stress and the evil eye.|aa-banner-stone-black-tourmaline.jpg|/search?q=black%20tourmaline|/search?q=protection;;love|Love & Harmony|Relationships · self-love|Rose Quartz|Rose Quartz opens the heart and softens how you give and receive love.|aa-banner-stone-rose-quartz.jpg|/search?q=rose%20quartz|/search?q=love;;focus|Focus & Clarity|Work · study · decisions|Lapis Lazuli|Lapis Lazuli clears mental fog and sharpens truth, focus and judgment.|aa-banner-stone-lapis-lazuli.jpg|/search?q=lapis%20lazuli|/search?q=focus;;confidence|Confidence & Drive|Courage · willpower|Tiger Eye|Tiger Eye steadies the nerves and returns your courage when you need it most.|aa-banner-stone-tiger-eye.jpg|/search?q=tiger%20eye|/search?q=confidence" | split:";;" -%}

    <div class="rf-grid">
      <div class="rf-intents" role="tablist" aria-label="Intentions">
        {%- for row in rows -%}{%- assign c = row | split:"|" -%}
          <button class="rf-chip{% if forloop.first %} on{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-i="{{ c[0] }}">
            <span class="rf-chip-txt"><span class="rf-chip-t">{{ c[1] }}</span><span class="rf-chip-s">{{ c[2] }}</span></span>
            <span class="rf-chip-ar" aria-hidden="true">&rarr;</span>
          </button>
        {%- endfor -%}
      </div>

      <div class="rf-reveal">
        {%- for row in rows -%}{%- assign c = row | split:"|" -%}
          <div class="rf-card{% if forloop.first %} on{% endif %}" data-c="{{ c[0] }}" role="tabpanel">
            <div class="rf-card-im" style="background-image:url('{{ c[5] | asset_url }}')"><span class="rf-card-tag">Your remedy</span></div>
            <div class="rf-card-b">
              <div class="rf-card-eyebrow">For {{ c[1] }}</div>
              <h3 class="rf-card-name">{{ c[3] }}</h3>
              <p class="rf-card-reason">{{ c[4] }}</p>
              <div class="rf-card-oud"><i>&#10022;</i> Available as Crystal, <b>Crystal + Oud</b>, or Oud Reserve</div>
              <div class="rf-card-cta">
                <a class="btn dark" href="{{ c[6] }}">Shop {{ c[3] }} &rarr;</a>
                <a class="rf-seeall" href="{{ c[7] }}">See all {{ c[1] }}</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Remedy Finder","settings":[],"presets":[{"name":"Remedy Finder"}]}
{% endschema %}
