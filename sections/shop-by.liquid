<section class="section"><div class="wrap">
  <div class="kick">Explore</div>
  <h2 class="t" style="margin-top:8px">{{ section.settings.heading }}</h2>
  <div class="tabs"><button class="on">By Intent</button><button>By Stone</button><button>By Ritual</button></div>
  <div class="tiles">
    {% for b in section.blocks %}
      <a class="tile" href="{{ b.settings.url }}" style="background-image:linear-gradient(180deg,rgba(28,22,14,.05) 30%,rgba(28,22,14,.66)),url('{{ b.settings.image | asset_url }}');background-size:cover;background-position:center">
        <div class="tn">{{ b.settings.title }}</div><div class="ts">{{ b.settings.stones }}</div>
      </a>
    {% endfor %}
  </div>
</div></section>
{% schema %}
{"name":"Shop by","max_blocks":4,
 "settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by intent, stone, or ritual"}],
 "blocks":[{"type":"tile","name":"Tile","settings":[
   {"type":"text","id":"title","label":"Title"},
   {"type":"text","id":"stones","label":"Stones"},
   {"type":"text","id":"image","label":"Image filename (assets)"},
   {"type":"url","id":"url","label":"Link"}]}],
 "presets":[{"name":"Shop by"}]}
{% endschema %}
