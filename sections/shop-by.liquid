<section class="section sby"><div class="wrap">
  <div class="kick">Explore</div>
  <h2 class="t" style="margin-top:8px">{{ section.settings.heading }}</h2>

  <div class="sby-tabs" id="sbyTabs">
    <button class="on" data-t="intent">By Intent</button>
    <button data-t="stone">By Stone</button>
    <button data-t="ritual">By Ritual</button>
    <span class="sby-underline" id="sbyUnderline"></span>
  </div>

  <div class="sby-panels">
    <div class="sby-panel on cols3" data-panel="intent">
      {%- assign rows = "Wealth & Fortune|Pyrite · Citrine · Green Aventurine|aa-banner-purpose-wealth-prosperity.jpg|/collections/money;;Peace & Calm|Amethyst · Selenite · Moonstone|aa-banner-purpose-peace-calm.jpg|/collections/purpose-peace-calm;;Protection|Black Tourmaline · Tiger Eye|aa-banner-purpose-protection.jpg|/search?q=protection;;Love & Harmony|Rose Quartz · Rhodonite|aa-banner-purpose-love-relationships.jpg|/search?q=rose%20quartz;;Health & Vitality|Bloodstone · Green Aventurine|aa-banner-purpose-health-wellness.jpg|/collections/purpose-health-wellness;;Focus & Clarity|Fluorite · Clear Quartz|aa-banner-purpose-focus-clarity.jpg|/search?q=focus" | split:";;" -%}
      {%- for row in rows -%}{%- assign c = row | split:"|" -%}
        <a class="stile" href="{{ c[3] }}"><span class="stile-im" style="background-image:url('{{ c[2] | asset_url }}')"></span><span class="stile-ov"></span>
          <span class="stile-b"><span class="stile-t">{{ c[0] }}</span><span class="stile-s">{{ c[1] }}</span><span class="stile-x">Explore &rarr;</span></span></a>
      {%- endfor -%}
    </div>

    <div class="sby-panel cols4" data-panel="stone">
      {%- assign rows = "Amethyst|Calm & clarity|aa-banner-stone-amethyst.jpg|/collections/amethyst;;Pyrite|Wealth & drive|aa-banner-stone-pyrite.jpg|/search?q=pyrite;;Tiger Eye|Confidence|aa-banner-stone-tiger-eye.jpg|/search?q=tiger%20eye;;Rose Quartz|Love & harmony|aa-banner-stone-rose-quartz.jpg|/search?q=rose%20quartz;;Citrine|Abundance|aa-banner-stone-citrine.jpg|/collections/citrine;;Green Aventurine|Luck|aa-banner-stone-green-aventurine.jpg|/search?q=green%20aventurine;;Black Tourmaline|Protection|aa-banner-stone-black-tourmaline.jpg|/search?q=black%20tourmaline;;Lapis Lazuli|Truth & focus|aa-banner-stone-lapis-lazuli.jpg|/search?q=lapis%20lazuli" | split:";;" -%}
      {%- for row in rows -%}{%- assign c = row | split:"|" -%}
        <a class="stile" href="{{ c[3] }}"><span class="stile-im" style="background-image:url('{{ c[2] | asset_url }}')"></span><span class="stile-ov"></span>
          <span class="stile-b"><span class="stile-t">{{ c[0] }}</span><span class="stile-s">{{ c[1] }}</span><span class="stile-x">Explore &rarr;</span></span></a>
      {%- endfor -%}
    </div>

    <div class="sby-panel cols3" data-panel="ritual">
      {%- assign rows = "crystal-bracelets|Daily Wear|Crystal bracelets;;mala|Meditation|Malas · 108 beads;;silver-bracelets|Silver Series|Silver-capped;;anklets|Anklets|Wear the energy;;pyramids|Home & Vastu|Pyramids & space;;crystals|Cleansing|Raw crystals & selenite" | split:";;" -%}
      {%- for row in rows -%}{%- assign c = row | split:"|" -%}{%- assign col = collections[c[0]] -%}
        <a class="stile" href="{{ col.url }}"><span class="stile-im" style="background-image:url('{{ col.image | default: col.products.first.featured_image | image_url: width: 700 }}')"></span><span class="stile-ov"></span>
          <span class="stile-b"><span class="stile-t">{{ c[1] }}</span><span class="stile-s">{{ c[2] }}</span><span class="stile-x">Explore &rarr;</span></span></a>
      {%- endfor -%}
    </div>
  </div>
</div></section>
{% schema %}
{"name":"Shop by","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by intent, stone, or ritual"}],"presets":[{"name":"Shop by"}]}
{% endschema %}
