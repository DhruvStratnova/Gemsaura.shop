<section class="section promos"><div class="wrap"><div class="promogrid">
  {%- assign rows = "New Arrivals|Discover the latest, just for you.|new-arrival|New;;Trending Now|Our most-loved this season.|crystal-bracelets|Trending;;Bestsellers|Customer favourites worth wearing.|our-products|Loved" | split:";;" -%}
  {%- for row in rows -%}{%- assign c = row | split:"|" -%}{%- assign col = collections[c[2]] -%}
    <a class="promo" href="{{ col.url }}">
      <div class="promo-b"><span class="promo-chip">{{ c[3] }}</span><h3>{{ c[0] }}</h3><p>{{ c[1] }}</p><span class="promo-shop">Shop now &rarr;</span></div>
      <span class="promo-im" style="background-image:url('{{ col.products.first.featured_image | image_url: width: 420 }}')"></span>
    </a>
  {%- endfor -%}
  <a class="promo promo--dark" href="{{ section.settings.oud_url | default: '#' }}">
    <div class="promo-b"><span class="promo-eyebrow">The signature &middot; coming soon</span><h3>Crystal + <span class="i">Oud</span></h3><p>Energy you wear &mdash; and breathe.</p><span class="promo-shop">Notify me &rarr;</span></div>
    <span class="promo-im promo-orb"></span>
  </a>
</div></div></section>
{% schema %}
{"name":"Promo cards","settings":[{"type":"url","id":"oud_url","label":"Crystal+Oud link"}],"presets":[{"name":"Promo cards"}]}
{% endschema %}
