<section class="sec"><div class="wrap"><div class="promos">
  <a class="promo rv" href="{{ section.settings.link1 | default: '/collections/new-arrival' }}">
    <img src="{{ section.settings.image1 | default: 'aa-banner-stone-rose-quartz.jpg' | asset_url }}" alt="">
    <div class="pb"><div class="eyebrow">{{ section.settings.eyebrow1 | default: 'Just landed' }}</div><h3>{{ section.settings.title1 | default: 'New Arrivals' }}</h3><span class="btn btn--light">Shop now</span></div>
  </a>
  <a class="promo rv" href="{{ section.settings.link2 | default: '/collections/crystal-bracelets' }}">
    <img src="{{ section.settings.image2 | default: 'aa-banner-purpose-wealth-prosperity.jpg' | asset_url }}" alt="">
    <div class="pb"><div class="eyebrow">{{ section.settings.eyebrow2 | default: 'For prosperity' }}</div><h3>{{ section.settings.title2 | default: 'Shop by intention' }}</h3><span class="btn btn--light">Explore</span></div>
  </a>
</div></div></section>
{% schema %}
{"name":"Promo banners","settings":[
  {"type":"text","id":"image1","label":"Image 1 (asset)"},{"type":"text","id":"eyebrow1","label":"Eyebrow 1"},{"type":"text","id":"title1","label":"Title 1"},{"type":"url","id":"link1","label":"Link 1"},
  {"type":"text","id":"image2","label":"Image 2 (asset)"},{"type":"text","id":"eyebrow2","label":"Eyebrow 2"},{"type":"text","id":"title2","label":"Title 2"},{"type":"url","id":"link2","label":"Link 2"}],
 "presets":[{"name":"Promo banners"}]}
{% endschema %}
